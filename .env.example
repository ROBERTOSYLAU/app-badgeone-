# Badge One - Production example
APP_ENV=production
APP_NAME=Badge One API

# Use PostgreSQL with psycopg dialect
DATABASE_URL=postgresql+psycopg://badgeone:badgeone@postgres:5432/badgeone
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
